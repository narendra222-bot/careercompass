# Copy to .env and fill in. Never commit .env.
ONET_RELEASE=31_0
ONET_DIR=data/onet_text
ONET_DB=data/onet.duckdb
ANONYMIZED_TELEMETRY=False

# LLM (optional - without a key the pipeline uses deterministic templates)
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_FAST=openai/gpt-oss-20b
LLM_MODEL_SMART=openai/gpt-oss-120b

# Accounts
# Random text, 32+ characters: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET=
# Google OAuth client id for "Continue with Google" (optional)
GOOGLE_CLIENT_ID=
ALLOW_EMAIL_LOGIN=true
# Where the web app runs (comma-separated)
CORS_ORIGINS=http://localhost:3000
